  {
    "name": "text_tts_cai_dan_1",
    "zh": "只要你想，我们随时都在",
    "ru": "Стоит тебе захотеть — мы всегда рядом.",
    "type": "string"
  },
  {
    "name": "text_tts_cai_dan_2",
    "zh": "多美好的一天，我们又见面了",
    "ru": "Какой прекрасный день, мы снова встретились!",
    "type": "string"
  },
  {
    "name": "text_tts_cai_dan_3",
    "zh": "又被抓到了，三二一变身",
    "ru": "Снова поймали! Три-два-один — трансформация!",
    "type": "string"
  },
  {
    "name": "text_tts_cai_dan_4",
    "zh": "哎呀又被发现了，看我在变样!",
    "ru": "Ой, опять меня заметили! Смотри, я сейчас преображусь!",
    "type": "string"
  },
  {
    "name": "text_tts_emotional",
    "zh": "与你一见如故，再见如初~",
    "ru": "С тобой — как со старым другом, а вновь — как в первый раз~",
    "type": "string"
  },
  {
    "name": "text_tts_excited",
    "zh": "跨越星辰大海，只为与你相遇~",
    "ru": "Сквозь звёзды и моря, лишь бы встретиться с тобой~",
    "type": "string"
  },
  {
    "name": "text_tts_first_cai_dan",
    "zh": "竟然被你找到啦,初次见面,请多关照",
    "ru": "Невероятно, вы меня нашли! Приятно познакомиться, буду рад помочь!",
    "type": "string"
  },
  {
    "name": "text_tts_happy",
    "zh": "生活明朗,万物可爱",
    "ru": "Жизнь светла, всё вокруг прекраснo.",
    "type": "string"
  },
  {
    "name": "text_tts_has_closed",
    "zh": "已经关上了",
    "ru": "Уже закрыто",
    "type": "string"
  },
  {
    "name": "text_tts_light_warning",
    "zh": "笑容是面对现实的强大武器哦~",
    "ru": "Улыбка — мощное оружие перед лицом реальности~",
    "type": "string"
  },
  {
    "name": "text_tts_ok",
    "zh": "好的",
    "ru": "Хорошо",
    "type": "string"
  },
  {
    "name": "text_tts_open_customize_ok",
